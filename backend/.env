# Environment Configuration Template
# Copy this file to .env and update the values below

# ================================
# Django Configuration
# ================================
SECRET_KEY=django-insecure-change-this-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ================================
# Database Configuration
# ================================
# PostgreSQL Settings (recommended for production)
DB_NAME=virtualtutor_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# SQLite Fallback (set to True for easy development)
USE_SQLITE=False

# ================================
# CORS Configuration
# ================================
# Set to True only in development
CORS_ALLOW_ALL_ORIGINS=False

# Specific origins (frontend URLs)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ================================
# JWT Configuration
# ================================
# These are handled in settings.py but can be overridden here if needed
# JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ================================
# Email Configuration (Optional)
# ================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ================================
# Additional Settings
# ================================
# Set to production, development, or testing
ENVIRONMENT=development

# Logging level
LOG_LEVEL=DEBUG
